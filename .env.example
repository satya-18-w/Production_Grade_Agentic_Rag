# --- GROQ REASONING ENGINE ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_FALLBACK_API_KEY=your_groq_fallback_api_key_here

# --- PORTKEY LLM GATEWAY ---
PORTKEY_API_KEY=your_portkey_api_key_here

# Saved Portkey config slugs — required only if your Portkey account has
# "block_inline_config" enabled (Settings > Configs), which rejects the
# fallback/cache/retry JSON sent inline via the x-portkey-config header.
# Create the two configs below in the Portkey dashboard and paste their
# "pc-..." slugs here. Leave unset if inline config is allowed.
# PORTKEY_GATEWAY_CONFIG_SLUG=pc-xxxxxxxx
# PORTKEY_GUARDRAIL_CONFIG_SLUG=pc-xxxxxxxx

# --- GOOGLE GEMINI EMBEDDINGS ---
GOOGLEGEMINI_API_KEY=your_gemini_api_key_here

# --- GEMINI VISION (multimodal image captioning) — optional, has defaults ---
GEMINI_VISION_MODEL=gemini-2.5-flash
ALLOW_EXTERNAL_IMAGE_FETCH=true

# --- LOCAL VISION FALLBACK — optional, has a default ---
# Used automatically when Gemini captioning fails (quota exhausted, rate
# limited, network error) — zero cost, runs on CPU.
SMOLVLM_MODEL_ID=HuggingFaceTB/SmolVLM-Instruct

# --- QDRANT VECTOR DB ---
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_CLUSTER_ENDPOINT=https://your-qdrant-cluster.aws.cloud.qdrant.io

# --- POSTGRES CHECKPOINTER ---
POSTGRES_URI=postgresql://postgres:password@localhost:5432/floatchat

# --- AUTH (app/auth/) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=replace_with_a_random_64_char_hex_secret
AUTH_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated browser origins allowed to call this API. "*" for local dev.
ALLOWED_ORIGINS=*

# --- OBSERVABILITY (LANGSMITH / LOGFIRE) ---
LOGFIRE_TOKEN=your_logfire_token_here
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=rag_scale_test
